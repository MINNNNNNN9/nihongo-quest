# 複製成 .env 後再啟動： cp .env.example .env
# 正式環境請務必換掉 SECRET_KEY 與資料庫密碼（python -c "import secrets; print(secrets.token_urlsafe(50))"）

DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=nihongo_quest
POSTGRES_USER=nihongo
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 對外埠號（本機已被占用時改這裡）
FRONTEND_PORT=5173
BACKEND_PORT=8010
WEB_PORT=8088
